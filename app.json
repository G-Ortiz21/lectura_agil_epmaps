{
  "expo": {
    "name": "lectura_agil_epmaps",
    "slug": "lectura_agil_epmaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lecturaepmaps",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.gd21osteam.lectura_agil_epmaps"
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lectura Ágil usa la cámara para fotografiar el medidor como evidencia de la lectura."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fa25566-e395-4469-a01c-379b79d149fe"
      }
    }
  }
}
